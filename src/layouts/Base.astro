---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Search from '../components/Search.astro';
import { url } from '../lib/url';
import { img } from '../lib/img';

interface Props {
  title: string;
  description?: string;
}

const NAME = 'Pablo de la Peña Aguilera';
const {
  title,
  description = 'Pablo de la Peña Aguilera (Peña-Aguilera, P.) is an ecologist and biogeographer at the University of Alcalá researching community assembly, species distribution models and wild bee pathogens.',
} = Astro.props;
const pageTitle = title === NAME ? `${NAME} · Ecologist & Biogeographer` : `${title} · ${NAME}`;
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
// Only the real site is indexed; fork or local preview builds stay out of search results.
const indexable = Astro.site?.host === 'pablodlpa.github.io';
const isHome = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === `${import.meta.env.BASE_URL.replace(/\/$/, '')}/index.html`;
const ogImage = new URL((await getImage({ src: img('1.hero-portrait.jpg'), width: 1200, format: 'jpg' })).src, Astro.site);

// Structured data so search engines connect the site with the person and his profiles.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: NAME,
  alternateName: ['Pablo Peña-Aguilera', 'Pablo de la Peña-Aguilera', 'Peña-Aguilera, P.'],
  honorificPrefix: 'Dr.',
  jobTitle: 'Postdoctoral researcher',
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  image: ogImage.href,
  email: 'mailto:pena.aguilera.p@gmail.com',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'University of Alcalá' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Swedish University of Agricultural Sciences' },
    { '@type': 'CollegeOrUniversity', name: 'Inland Norway University of Applied Sciences' },
    { '@type': 'CollegeOrUniversity', name: 'University of Alcalá' },
  ],
  knowsAbout: ['Ecology', 'Biogeography', 'Community assembly', 'Species distribution modelling', 'Molecular ecology', 'Entomology', 'Bumblebee pathogens'],
  sameAs: ['https://orcid.org/0000-0002-8999-1140', 'https://www.researchgate.net/profile/Pablo-De-La-Pena-Aguilera'],
};

const nav = [
  { href: '', label: 'Home' },
  { href: 'research.html', label: 'Research & Projects' },
  { href: 'publications.html', label: 'Publications' },
  { href: 'beyond-research.html', label: 'Scientific outreach' },
  { href: 'contact.html', label: 'Contact' },
];
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\//, '').replace(/^index\.html$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    {!indexable && <meta name="robots" content="noindex" />}
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <meta name="theme-color" content="#17372f" />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap"
    />
    <script is:inline>
      // Apply the saved or system theme before paint to avoid a flash.
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        document.documentElement.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={url()}>Pablo de la Peña Aguilera</a>

        <nav aria-label="Main">
          <button class="icon-btn menu-btn" aria-expanded="false" aria-controls="nav-list">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <span class="sr-only">Menu</span>
          </button>
          <ul id="nav-list">
            {nav.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={here === item.href ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="tools">
          <Search />
          <button class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode">
            <svg class="sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <p>© {new Date().getFullYear()} Pablo de la Peña Aguilera</p>
        <p>
          <a href="https://orcid.org/0000-0002-8999-1140">ORCID</a> ·
          <a href="https://www.researchgate.net/profile/Pablo-De-La-Pena-Aguilera">ResearchGate</a> ·
          <a href={url('files/CV.pdf')}>CV (PDF)</a>
        </p>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle')!;
      toggle.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // Highlight the search term after following a search result. The script loads only in that case.
      if (new URLSearchParams(location.search).has('highlight')) {
        const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind-highlight.js`;
        import(/* @vite-ignore */ src)
          // @ts-ignore: global from pagefind-highlight.js
          .then(() => new PagefindHighlight({ highlightParam: 'highlight' }))
          .catch(() => {});
      }

      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      menuBtn.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') !== 'true';
        menuBtn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, #17372f 94%, transparent);
    backdrop-filter: blur(10px);
    color: var(--on-forest);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 64px; }
  .brand {
    margin-right: auto; color: var(--on-forest);
    font: 700 1.05rem/1.2 var(--font-heading); letter-spacing: -0.02em; text-decoration: none;
  }
  .brand:hover { color: #fff; }
  nav ul { display: flex; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  nav a {
    display: block; padding: 0.55rem 0.8rem; border-radius: 999px;
    color: rgb(249 247 241 / 0.82); font-size: 0.93rem; font-weight: 500; text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  nav a:hover { color: #fff; background: rgb(255 255 255 / 0.08); }
  nav a[aria-current='page'] { color: #fff; background: rgb(255 255 255 / 0.14); }

  .tools { display: flex; gap: 0.25rem; }
  :global(.icon-btn) {
    display: inline-grid; place-items: center; width: 44px; height: 44px;
    border: 0; border-radius: 50%; background: transparent; color: var(--on-forest); cursor: pointer;
    transition: background-color 0.2s;
  }
  :global(.icon-btn:hover) { background: rgb(255 255 255 / 0.1); }
  :global(.icon-btn svg) { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  :global([data-theme='dark']) .sun, .moon { display: none; }
  :global([data-theme='dark']) .moon { display: block; }

  .menu-btn { display: none; }

  @media (max-width: 960px) {
    .menu-btn { display: inline-grid; }
    nav ul {
      display: none; position: absolute; inset: 64px 0 auto 0;
      flex-direction: column; padding: 0.5rem 1.25rem 1rem;
      background: #17372f; border-top: 1px solid rgb(255 255 255 / 0.1);
    }
    .menu-btn[aria-expanded='true'] + ul { display: flex; }
    nav a { padding: 0.8rem 1rem; }
  }

  .site-footer { margin-top: 5rem; padding: 2rem 0; background: #17372f; color: rgb(249 247 241 / 0.8); font-size: 0.9rem; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; }
  .foot p { margin: 0; }
  .foot a { color: #fff; }
</style>
