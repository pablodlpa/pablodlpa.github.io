---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <div class="container page-head" data-pagefind-ignore="all">
    <span class="eyebrow">404</span>
    <h1>This page wandered off its range</h1>
    <p>The page you are looking for does not exist. Try the search (press <kbd>/</kbd>) or go back home.</p>
    <a class="btn btn-primary" href={url()}>Back to home</a>
  </div>
</Base>
